# Binaries
/drivel
/bin/
*.exe

# Local runtime data / mounts
/data/
/mnt/
*.db

# Secrets / OAuth
credentials.json
token.json
*.local.json

# Go
/vendor/

# Claude Code working directories. A worktree here is a second checkout of this
# repo living inside it: untracked, so invisible to `git status --short`'s tail,
# and swept straight into a commit by `git add -A`. Settings under .claude are
# deliberately not ignored — those are shareable project config.
/.claude/worktrees/

# Hugo build output for the website in site/.
/site/public/
/site/resources/
/site/.hugo_build.lock
/site/_vendor/
