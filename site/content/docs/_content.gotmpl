{{/*
  Builds the docs section from ../docs/user, which hugo.toml mounts at
  assets/manual. Those files are written to be read on GitHub first, so they
  carry no front matter and open with an H1 instead; this lifts the title out of
  that H1 so nothing has to be added to them. Taking the H1 rather than
  humanising the filename is what makes "SFTP" and "fstab" come out with the
  casing their authors chose.

  A file with no H1 falls back to its filename, and an unlisted file still gets
  a page -- it just sorts last, which is a new doc appearing at the bottom of
  the nav rather than not appearing at all.
*/}}

{{ $order := dict
    "README"             1
    "status"             2
    "quickstart"         3
    "install"            4
    "google-cloud-setup" 5
    "sftp"               6
    "configuration"      7
    "lazy-mode"          8
    "data-safety"        9
    "fstab"              10
    "platforms"          11
    "troubleshooting"    12
}}

{{ range resources.Match "manual/*.md" }}
  {{ $base := path.BaseName .Name }}
  {{ $raw := .Content }}

  {{ $title := $base }}
  {{ with findRE `(?m)^#[ \t]+(.+)$` $raw 1 }}
    {{ $title = replaceRE `(?m)^#[ \t]+[ \t]*` "" (index . 0) }}
    {{/* An H1 may carry inline code -- "Lazy mode (`-lazy`)" -- and a <title>
         renders the backticks literally. */}}
    {{ $title = replaceRE "`" "" $title }}
  {{ end }}

  {{/* Hextra's docs layout prints the page title as an H1 of its own, so a
       file that opens with one -- which every file here does, being written for
       GitHub -- rendered its heading twice on the page and gave it two H1
       elements. Drop the opening heading and keep the title lifted from it.

       Anchored to the very start (\A) rather than matched anywhere, so this
       removes the heading it took the title from and never some later one. A
       file whose H1 is not the first thing in it keeps both, which is visible
       and fixable, where silently eating a mid-document heading would not be. */}}
  {{ $body := $raw }}
  {{ with findRE `\A#[ \t]+[^\n]*\n?` $raw 1 }}
    {{ $body = strings.TrimLeft "\n" (strings.TrimPrefix (index . 0) $raw) }}
  {{ end }}

  {{ $slug := cond (eq $base "README") "overview" $base }}

  {{ $.AddPage (dict
      "path"    $slug
      "title"   $title
      "weight"  (index $order $base | default 99)
      "params"  (dict "sourceFile" (printf "docs/user/%s.md" $base))
      "content" (dict "mediaType" "text/markdown" "value" $body)
  ) }}
{{ end }}
