.TH DRIVEL 1 "2026-09-05" "drivel" "User Commands"
.SH NAME
drivel \- Drive-backed FUSE interceptor filesystem
.SH SYNOPSIS
.B drivel
.RI [ command ]
.RI [ flags ]
.br
.B drivel login
